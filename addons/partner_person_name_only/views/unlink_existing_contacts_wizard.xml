<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_unlink_existing_contacts_wizard_form" model="ir.ui.view">
    <field name="name">unlink.existing.contacts.wizard.form</field>
    <field name="model">unlink.existing.contacts.wizard</field>
    <field name="arch" type="xml">
      <form string="Unlink Contact(s)">
        <group>
          <field name="company_id" readonly="1"/>
          <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
        </group>
        <footer>
          <button name="action_unlink" type="object" class="btn-primary" string="Unlink"/>
          <button special="cancel" class="btn-secondary" string="Cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_unlink_existing_contacts_wizard" model="ir.actions.act_window">
    <field name="name">Unlink Contact(s)</field>
    <field name="res_model">unlink.existing.contacts.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="context">{'default_company_id': active_id}</field>
  </record>
</odoo>
