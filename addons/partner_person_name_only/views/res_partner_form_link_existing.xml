<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="res_partner_form_link_existing_contacts_button" model="ir.ui.view">
    <field name="name">res.partner.form.link.existing.contacts.button</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='delete']" position="after">
        <button name="action_unlink_from_parent"
                type="object"
                string="Unlink"
                class="btn-secondary"
                invisible="not parent_id or is_company"/>
      </xpath>
    </field>
  </record>
</odoo>
