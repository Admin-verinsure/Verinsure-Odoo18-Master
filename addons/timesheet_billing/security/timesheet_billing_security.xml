<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_timesheet_billing" model="ir.module.category">
        <field name="name">Timesheet Billing</field>
        <field name="description">Access rights for hourly timesheet billing.</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_timesheet_user" model="res.groups">
        <field name="name">Timesheet User</field>
        <field name="category_id" ref="module_category_timesheet_billing"/>
        <field name="comment">Can log and view their own timesheets.</field>
    </record>

    <record id="group_timesheet_manager" model="res.groups">
        <field name="name">Timesheet Manager</field>
        <field name="category_id" ref="module_category_timesheet_billing"/>
        <field name="implied_ids" eval="[(4, ref('group_timesheet_user'))]"/>
        <field name="comment">Can view and approve every employee's timesheets.</field>
    </record>

    <record id="group_billing_manager" model="res.groups">
        <field name="name">Billing Manager</field>
        <field name="category_id" ref="module_category_timesheet_billing"/>
        <field name="implied_ids" eval="[(4, ref('group_timesheet_manager'))]"/>
        <field name="comment">Can generate customer invoices from approved timesheets.</field>
    </record>
</odoo>
