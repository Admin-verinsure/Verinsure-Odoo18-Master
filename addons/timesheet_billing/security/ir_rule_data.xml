<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_analytic_line_own_timesheets" model="ir.rule">
        <field name="name">Timesheet User: own timesheets only</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_timesheet_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

    <record id="rule_analytic_line_manager_all" model="ir.rule">
        <field name="name">Timesheet Manager: all timesheets</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_timesheet_manager'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>
</odoo>
