<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Deliberately NOT inheriting hr_timesheet's own list/form views:
         their exact ids vary between Community builds and any 3rd-party
         timesheet module (e.g. Cybrosys Timesheet) installed alongside
         this one, and a broken inherit_id would abort the whole module
         install. Instead this module ships its own dedicated Billing
         list (below) - it works regardless of which Timesheets UI is
         active, and the billing fields are still visible/editable from
         the timesheet's own form view via the standard "Log a note /
         extra fields" mechanism in Studio if deeper integration is
         wanted. -->
    <!-- Dedicated Billing list/form so the module works independently
         of whichever Timesheets UI (hr_timesheet, Cybrosys Timesheet,
         etc.) is installed. -->
    <record id="view_timesheet_billing_line_list" model="ir.ui.view">
        <field name="name">account.analytic.line.list.timesheet.billing.standalone</field>
        <field name="model">account.analytic.line</field>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <list string="Billable Timesheets" decoration-muted="billing_status == 'invoiced'"
                  decoration-success="approved and billing_status != 'invoiced'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="name"/>
                <field name="unit_amount" widget="float_time" sum="Total Hours"/>
                <field name="hourly_rate"/>
                <field name="bill_amount" sum="Total Amount"/>
                <field name="billable"/>
                <field name="approved"/>
                <field name="billing_status" widget="badge"
                       decoration-success="billing_status == 'invoiced'"
                       decoration-info="billing_status == 'to_invoice'"
                       decoration-warning="billing_status == 'partially_invoiced'"/>
                <field name="invoice_id"/>
                <button name="action_approve_timesheets" type="object" string="Approve"
                        icon="fa-check" invisible="approved"
                        groups="timesheet_billing.group_timesheet_manager"/>
            </list>
        </field>
    </record>

    <record id="view_timesheet_billing_line_search" model="ir.ui.view">
        <field name="name">account.analytic.line.search.timesheet.billing</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <search string="Billable Timesheets">
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <filter string="Billable" name="filter_billable" domain="[('billable','=',True)]"/>
                <filter string="Approved" name="filter_approved" domain="[('approved','=',True)]"/>
                <filter string="Not Approved" name="filter_not_approved" domain="[('approved','=',False)]"/>
                <filter string="To Invoice" name="filter_to_invoice"
                        domain="[('billing_status','in',('to_invoice','partially_invoiced'))]"/>
                <filter string="Invoiced" name="filter_invoiced" domain="[('billing_status','=','invoiced')]"/>
                <separator/>
                <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                <filter string="Billing Status" name="group_billing_status" context="{'group_by': 'billing_status'}"/>
            </search>
        </field>
    </record>

    <record id="action_timesheet_billing_lines" model="ir.actions.act_window">
        <field name="name">Billable Timesheets</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('billable', '=', True)]</field>
        <field name="context">{'search_default_filter_billable': 1}</field>
        <field name="search_view_id" ref="view_timesheet_billing_line_search"/>
    </record>

    <!-- Bind the standalone list view explicitly to THIS action only, so
         it never becomes the model-wide default list view for
         account.analytic.line and cannot clash with hr_timesheet's or
         Cybrosys Timesheet's own views. -->
    <record id="action_timesheet_billing_lines_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_timesheet_billing_line_list"/>
        <field name="act_window_id" ref="action_timesheet_billing_lines"/>
    </record>
</odoo>
