<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_customer_payment_reminder" model="ir.cron">
        <field name="name">Customer Payment Reminder: Process Reminders</field>
        <field name="model_id" ref="model_customer_payment_reminder_service"/>
        <field name="state">code</field>
        <field name="code">model.cron_process_payment_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>