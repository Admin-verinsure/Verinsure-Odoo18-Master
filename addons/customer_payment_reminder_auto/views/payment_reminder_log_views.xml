<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_payment_reminder_log_tree" model="ir.ui.view">
        <field name="name">customer.payment.reminder.log.tree</field>
        <field name="model">customer.payment.reminder.log</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="reminder_datetime"/>
                <field name="commercial_partner_id"/>
                <field name="company_id"/>
                <field name="outstanding_amount"/>
                <field name="recipient_email"/>
                <field name="status"/>
                <field name="mail_state" optional="show"/>
                <field name="is_dry_run"/>
                <field name="reason" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_customer_payment_reminder_log_form" model="ir.ui.view">
        <field name="name">customer.payment.reminder.log.form</field>
        <field name="model">customer.payment.reminder.log</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="reminder_datetime"/>
                            <field name="status"/>
                            <field name="is_dry_run"/>
                            <field name="mail_mail_id"/>
                            <field name="mail_state"/>
                        </group>
                        <group>
                            <field name="commercial_partner_id"/>
                            <field name="company_id"/>
                            <field name="outstanding_amount"/>
                            <field name="recipient_email"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_customer_payment_reminder_log_search" model="ir.ui.view">
        <field name="name">customer.payment.reminder.log.search</field>
        <field name="model">customer.payment.reminder.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="commercial_partner_id"/>
                <field name="company_id"/>
                <field name="recipient_email"/>
                <field name="status"/>
                <filter string="Sent" name="sent" domain="[('status', '=', 'sent')]"/>
                <filter string="Skipped" name="skipped" domain="[('status', '=', 'skipped')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <filter string="Dry Run" name="dry_run" domain="[('is_dry_run', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_by_company_id" context="{'group_by': 'company_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Customer" name="group_by_customer" context="{'group_by': 'commercial_partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_customer_payment_reminder_log" model="ir.actions.act_window">
        <field name="name">Payment Reminder Logs</field>
        <field name="res_model">customer.payment.reminder.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_customer_payment_reminder_log_search"/>
    </record>
</odoo>