<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_customer_payment_reminder" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.customer.payment.reminder</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting id="payment_reminder_enabled" help="Enable automated payment reminders for the current company.">
                    <field name="payment_reminder_enabled"/>
                </setting>
                <setting id="payment_reminder_min_outstanding" help="Minimum net receivable balance required before sending a reminder.">
                    <field name="payment_reminder_min_outstanding"/>
                </setting>
                <setting id="payment_reminder_cooldown_days" help="Minimum delay between reminders for the same customer.">
                    <field name="payment_reminder_cooldown_days"/>
                </setting>
                <setting id="payment_reminder_disable_followers" help="Tick to stop using the followers of the overdue invoices when no earlier invoice email is found.">
                    <field name="payment_reminder_disable_followers"/>
                </setting>
                <setting id="payment_reminder_statement_start" help="Start date of the statement attached to reminders when none is chosen (default 1 March 2026).">
                    <field name="payment_reminder_statement_start"/>
                </setting>
                <setting id="payment_reminder_require_shared_docs" help="Only remind customers who were already emailed an invoice and a statement.">
                    <field name="payment_reminder_require_shared_docs"/>
                    <div class="content-group mt-2" invisible="not payment_reminder_require_shared_docs">
                        <label for="payment_reminder_shared_docs_since" class="o_light_label me-2"/>
                        <field name="payment_reminder_shared_docs_since" class="oe_inline"/>
                    </div>
                </setting>
                <setting id="payment_reminder_require_recent_statement" help="Only remind customers whose statement was generated from the Customer Statement screen within the days set here.">
                    <field name="payment_reminder_require_recent_statement"/>
                    <div class="content-group mt-2" invisible="not payment_reminder_require_recent_statement">
                        <field name="payment_reminder_statement_recent_days" class="oe_inline"/> days
                    </div>
                </setting>
                <setting id="payment_reminder_disable_statement" help="Tick to send reminders without the up-to-date Customer Statement PDF attached.">
                    <field name="payment_reminder_disable_statement"/>
                </setting>
                <setting id="payment_reminder_dry_run" help="Log eligible reminders without sending emails while testing.">
                    <field name="payment_reminder_dry_run"/>
                </setting>
                <setting id="payment_reminder_template_id" help="Optional email template override for payment reminders.">
                    <field name="payment_reminder_template_id"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>