<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_customer_payment_reminder" model="ir.ui.view">
        <field name="name">res.partner.form.customer.payment.reminder</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_run_payment_reminder_dry_run"
                        type="object"
                        string="Test Payment Reminder"
                        class="btn-secondary"
                        invisible="customer_rank == 0"/>
                <button name="action_open_payment_reminder_logs"
                        type="object"
                        string="Reminder Logs"
                        class="btn-secondary"
                        invisible="customer_rank == 0"/>
            </xpath>
            <xpath expr="//field[@name='email']" position="after">
                <field name="payment_reminder_enabled" invisible="customer_rank == 0"/>
                <field name="payment_reminder_email_override" invisible="customer_rank == 0"/>
            </xpath>
        </field>
    </record>
</odoo>