<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_statement_generation_log_tree" model="ir.ui.view">
        <field name="name">customer.statement.generation.log.tree</field>
        <field name="model">customer.statement.generation.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="generated_at"/>
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="output"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_customer_statement_generation_log_search" model="ir.ui.view">
        <field name="name">customer.statement.generation.log.search</field>
        <field name="model">customer.statement.generation.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_customer_statement_generation_log" model="ir.actions.act_window">
        <field name="name">Statement Generation Log</field>
        <field name="res_model">customer.statement.generation.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_customer_statement_generation_log"
              name="Statement Generation Log"
              parent="account.menu_finance_receivables"
              action="action_customer_statement_generation_log"
              groups="account.group_account_user"
              sequence="22"/>
</odoo>
