<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_akahu_credential_form" model="ir.ui.view">
        <field name="name">akahu.credential.form</field>
        <field name="model">akahu.credential</field>
        <field name="arch" type="xml">
            <form string="Akahu API Credentials">
                <header>
                    <button name="action_connect_akahu_oauth"
                        string="Connect Akahu"
                        type="object"
                        class="btn-primary"
                        icon="fa-link"
                        invisible="not has_app_token or not has_app_secret or has_user_token"
                        groups="base.group_erp_manager"/>
                    <button name="action_reauthorize_akahu_oauth"
                        string="Reauthorize / Replace Credentials"
                        type="object"
                        class="btn-primary"
                        icon="fa-refresh"
                        invisible="not has_app_token or not has_app_secret or not has_user_token"
                        groups="base.group_erp_manager"/>
                    <button name="action_test_connection"
                            string="Test Connection"
                            type="object"
                            class="btn-primary"
                            icon="fa-plug"
                            invisible="not has_user_token"/>
                    <!-- SEC-03: Token rotation / revocation (SOW clause 2.2.1.d) -->
                    <button name="action_revoke_credentials"
                            string="Revoke Credentials…"
                            type="object"
                            class="btn-danger"
                            icon="fa-trash"
                            confirm="This will open a confirmation step before clearing any credentials."
                            groups="base.group_erp_manager"/>
                </header>
                <sheet>
                    <!-- Error Ribbon -->
                    <widget name="web_ribbon"
                            title="Error"
                            bg_color="bg-danger"
                            invisible="connection_status != 'error'"/>

                    <!-- Connected Ribbon -->
                    <widget name="web_ribbon"
                            title="Connected"
                            bg_color="bg-success"
                            invisible="connection_status != 'ok'"/>

                    <div class="oe_title">
                        <h1><field name="company_id" readonly="1"/></h1>
                    </div>

                    <group string="Akahu App Credentials">
                        <group>
                            <field name="has_app_token" invisible="1"/>
                            <field name="has_app_secret" invisible="1"/>
                            <field name="has_user_token" invisible="1"/>

                            <div class="o_form_label">App Token</div>
                            <field name="app_token"
                                widget="password"
                                placeholder="app_token_xxxxxxxxxxxxxxxxxxxxxxx"
                                nolabel="1"
                                groups="base.group_erp_manager"
                                invisible="id and has_app_token"/>
                            <div invisible="not id or not has_app_token">••••••••••••••••</div>

                            <div class="o_form_label">App Secret</div>
                            <field name="app_secret"
                                widget="password"
                                placeholder="your-akahu-app-secret"
                                nolabel="1"
                                groups="base.group_erp_manager"
                                invisible="id and has_app_secret"/>
                            <div invisible="not id or not has_app_secret">••••••••••••••••</div>

                            <div class="o_form_label">OAuth Redirect URI</div>
                            <field name="oauth_redirect_uri"
                                nolabel="1"
                                groups="base.group_erp_manager"
                                placeholder="https://your-domain.example.nz/nz_bank_reconciliation/oauth/api_redirect"/>

                            <div class="o_form_label">User Access Token</div>
                            <div invisible="not id or not has_user_token">Configured</div>
                            <div invisible="id and has_user_token">Not Connected</div>

                            <button name="action_open_replace_credentials_wizard"
                                 string="Configure App Credentials"
                                 type="object"
                                 class="btn-primary"
                                 icon="fa-plus"
                                 groups="base.group_erp_manager"
                                 invisible="not id"/>
                        </group>

                        <group string="Connection Status">
                            <field name="connection_status"
                                   widget="badge"
                                   decoration-success="connection_status == 'ok'"
                                   decoration-danger="connection_status == 'error'"
                                   decoration-warning="connection_status == 'untested'"/>
                            <field name="last_tested"/>

                            <field name="error_message"
                                   invisible="not error_message"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle me-2"/>
                        <strong>Connect Akahu via OAuth:</strong>
                        Enter your App Token, App Secret, and configured redirect URI, then use <em>Connect Akahu</em> to authorize and store the User Access Token securely.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_akahu_credential_list" model="ir.ui.view">
        <field name="name">akahu.credential.list</field>
        <field name="model">akahu.credential</field>
        <field name="arch" type="xml">
            <list string="Akahu Credentials">
                <field name="company_id"/>
                <field name="connection_status"
                       widget="badge"
                       decoration-success="connection_status == 'ok'"
                       decoration-danger="connection_status == 'error'"
                       decoration-warning="connection_status == 'untested'"/>
                <field name="last_tested"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_akahu_credential" model="ir.actions.act_window">
        <field name="name">Akahu Credentials</field>
        <field name="res_model">akahu.credential</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>