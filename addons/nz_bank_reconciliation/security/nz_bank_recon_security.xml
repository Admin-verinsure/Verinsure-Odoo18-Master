<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Akahu multi-company rules ───────────────────────────────────── -->
        <record id="akahu_credential_company_rule" model="ir.rule">
            <field name="name">Akahu Credential: Multi-company</field>
            <field name="model_id" ref="model_akahu_credential"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
        </record>

        <record id="akahu_account_company_rule" model="ir.rule">
            <field name="name">Akahu Account: Multi-company</field>
            <field name="model_id" ref="model_akahu_account"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <!-- VNZ-02 FIX: account.group_account_manager previously had NO rule
             on akahu.account, akahu.sync.log, akahu.company.mapping,
             auto.reconciliation.config, or auto.reconciliation.log. In Odoo,
             a group with zero ir.rule entries for a model gets NO company
             restriction at all on that model — this is what let any
             Accounting Manager read/write/purge every company's data via
             sudo() cron/engine entry points. Adding an explicit manager rule
             on each model (mirroring the existing user-level rule) closes
             that gap for all group_account_manager users, independent of
             sudo(). -->
        <record id="akahu_account_manager_company_rule" model="ir.rule">
            <field name="name">Akahu Account: Multi-company (Manager)</field>
            <field name="model_id" ref="model_akahu_account"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
        </record>

        <record id="akahu_sync_log_company_rule" model="ir.rule">
            <field name="name">Akahu Sync Log: Multi-company</field>
            <field name="model_id" ref="model_akahu_sync_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <record id="akahu_sync_log_manager_company_rule" model="ir.rule">
            <field name="name">Akahu Sync Log: Multi-company (Manager)</field>
            <field name="model_id" ref="model_akahu_sync_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
        </record>

        <record id="akahu_company_mapping_company_rule" model="ir.rule">
            <field name="name">Akahu Company Mapping: Multi-company</field>
            <field name="model_id" ref="model_akahu_company_mapping"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <record id="akahu_company_mapping_manager_company_rule" model="ir.rule">
            <field name="name">Akahu Company Mapping: Multi-company (Manager)</field>
            <field name="model_id" ref="model_akahu_company_mapping"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
        </record>

        <!-- ── Reconciliation multi-company rules ─────────────────────────── -->
        <record id="auto_reconciliation_config_company_rule" model="ir.rule">
            <field name="name">Reconciliation Config: Multi-company</field>
            <field name="model_id" ref="model_auto_reconciliation_config"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <record id="auto_reconciliation_config_manager_company_rule" model="ir.rule">
            <field name="name">Reconciliation Config: Multi-company (Manager)</field>
            <field name="model_id" ref="model_auto_reconciliation_config"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
        </record>

        <record id="auto_reconciliation_log_company_rule" model="ir.rule">
            <field name="name">Reconciliation Log: Multi-company</field>
            <field name="model_id" ref="model_auto_reconciliation_log"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <record id="auto_reconciliation_log_manager_company_rule" model="ir.rule">
            <field name="name">Reconciliation Log: Multi-company (Manager)</field>
            <field name="model_id" ref="model_auto_reconciliation_log"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
        </record>

        <!-- VNZ-16 FIX: an inter-company mapping's counterpart_company_id had
             no rule restriction at all, so a manager could point it at a
             company they cannot otherwise access. Restrict both sides of
             the mapping to the caller's allowed companies. -->
        <record id="akahu_company_mapping_counterpart_rule" model="ir.rule">
            <field name="name">Akahu Company Mapping: Counterpart must be an allowed company</field>
            <field name="model_id" ref="model_akahu_company_mapping"/>
            <field name="domain_force">[('counterpart_company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_manager')), (4, ref('account.group_account_user'))]"/>
        </record>

    </data>
</odoo>
