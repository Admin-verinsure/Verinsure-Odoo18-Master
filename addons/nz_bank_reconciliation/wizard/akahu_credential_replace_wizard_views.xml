<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_akahu_credential_replace_wizard_form" model="ir.ui.view">
            <field name="name">akahu.credential.replace.wizard.form</field>
            <field name="model">akahu.credential.replace.wizard</field>
            <field name="arch" type="xml">
                <form string="Replace Akahu Credentials">
                    <sheet>
                        <group>
                            <field name="credential_id" invisible="1"/>
                            <field name="new_app_token" password="True" placeholder="app_token_xxxxxxxxxxxxxxxxxxxxxxx"/>
                            <field name="new_app_secret" password="True" placeholder="Your Akahu App Secret"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_save"
                                string="Save"
                                type="object"
                                class="btn-primary"
                                data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
