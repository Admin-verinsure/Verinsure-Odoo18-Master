<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_akahu_oauth_account_select_wizard_form" model="ir.ui.view">
            <field name="name">akahu.oauth.account.select.wizard.form</field>
            <field name="model">akahu.oauth.account.select.wizard</field>
            <field name="arch" type="xml">
                <form string="Connect Akahu">
                    <sheet>
                        <group>
                            <field name="credential_id" invisible="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="account_id"/>
                            <field name="selected_option_id"/>
                        </group>
                        <group string="Available Akahu Accounts">
                            <field name="option_ids" nolabel="1">
                                <tree editable="false">
                                    <field name="display_name"/>
                                    <field name="bank_name"/>
                                    <field name="formatted_account"/>
                                    <field name="account_name"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_save"
                                string="Save / Connect Account"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
