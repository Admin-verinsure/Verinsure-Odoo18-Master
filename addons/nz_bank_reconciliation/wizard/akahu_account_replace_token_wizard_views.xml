<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_akahu_account_replace_token_wizard_form" model="ir.ui.view">
            <field name="name">akahu.account.replace.token.wizard.form</field>
            <field name="model">akahu.account.replace.token.wizard</field>
            <field name="arch" type="xml">
                <form string="Replace User Token">
                    <sheet>
                        <group>
                            <field name="account_id" invisible="1"/>
                            <field name="new_user_token"
                                   widget="password"
                                   placeholder="user_token_xxxxxxxxxxxxxxxxxxxxxxx"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_save"
                                string="Save"
                                type="object"
                                class="btn-primary"
                                data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
